# Backend origin for Next.js rewrites, without /api. Local default shown.
# On Vercel set this to the backend's HTTPS origin and rebuild.
# Browser requests stay on the frontend origin. Never add database credentials here.
SERVER_URL=http://127.0.0.1:3001

# Canonical public frontend origin for SEO. Use the stable domain, not a preview URL.
SITE_URL=https://learning-platform-gray-mu.vercel.app
